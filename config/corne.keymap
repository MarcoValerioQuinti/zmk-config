#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE_WIN 0
#define SYM      1
#define NUM      2
#define ACC      4
#define NAV      3
#define BASE_MAC 5

/* =============================================================
 * MACROS — Accenti italiani (dead key: grave/acute + lettera)
 * Funzionano con layout US International o Italiano su OS.
 * ============================================================= */
/ {
    macros {
        it_a_grv: it_a_grv { compatible = "zmk,behavior-macro"; label = "IT_A_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp A>; };
        it_e_grv: it_e_grv { compatible = "zmk,behavior-macro"; label = "IT_E_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp E>; };
        it_e_acu: it_e_acu { compatible = "zmk,behavior-macro"; label = "IT_E_ACU"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp SQT   &kp E>; };
        it_i_grv: it_i_grv { compatible = "zmk,behavior-macro"; label = "IT_I_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp I>; };
        it_o_grv: it_o_grv { compatible = "zmk,behavior-macro"; label = "IT_O_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp O>; };
        it_u_grv: it_u_grv { compatible = "zmk,behavior-macro"; label = "IT_U_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp U>; };
    };

/* =============================================================
 * HOME ROW MODS
 * ============================================================= */
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bs_layer: backspace_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>; // Il tempo (in ms) per cui devi tenere premuto per attivare il layer
            quick-tap-ms = <200>;    // Permette di fare tap ripetuti per cancellare velocemente
            bindings = <&mo>, <&kp>;
        };
    };

/* =============================================================
 * KEYMAP — Carosello: BASE ▶ SYM ▶ NUM ▶ ACC ▶ NAV ▶ BASE
 * Thumb sx-esterno = avanza carosello
 * Thumb dx-esterno = torna a BASE (HOME)
 * MAC toggle = &tog BASE_MAC dal layer NAV
 * ============================================================= */

        keymap {
                compatible = "zmk,keymap";
        // ┌────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │ Q  │ W  │ E  │ R  │ T  │              │ Y  │ U  │ I  │ O  │ P  │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │A/⌥ │S/⌃ │D/⌘ │F/⇧ │ G  │              │ H  │J/⇧ │K/⌘ │L/⌃ │;/⌥ │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │ Z  │ X  │ C  │ V  │ B  │              │ N  │ M  │ ,  │ .  │ /  │
        // └────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────────┬────────┐  ┌──────────┬─────┬─────┐
        //      │ TAB │ SPACE/NUM │ →SYM ▶ │  │ BSPC/ACC │ ENT │ ESC │
        //      └─────┴───────────┴────────┘  └──────────┴─────┴─────┘
                base_win_layer {
                        bindings = <
   &kp TAB   &kp Q        &kp W        &kp E        &kp R        &kp T          &kp Y     &kp U        &kp I        &kp O        &kp P    &kp BSPC
   &kp LCTRL &hm LALT A   &hm LCTRL S  &hm LGUI D  &hm LSHFT F   &kp G          &kp H     &hm RSHFT J  &hm RGUI K   &hm RCTRL L  &hm LALT SEMI &kp SQT
   &kp LSHFT &kp Z        &kp X        &kp C        &kp V        &kp B          &kp N     &kp M        &kp COMMA    &kp DOT      &kp FSLH &kp ESC
                                       &kp TAB      &bs_layer 2 SPACE    &to SYM        &kp RET   &bs_layer 4 BSPC     &kp ESC
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │  `   │ &  │ ^  │ |  │ ~  │              │ !  │ [  │ ]  │ '  │ "  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │  /   │ *  │ +  │ :  │ ;  │              │ _  │ (  │ )  │ -  │ =  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │  %   │ #  │ <  │ >  │ ?  │              │ \  │ {  │ }  │ @  │ $  │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ →NAV ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘

                sym_layer {
                        bindings = <
   &kp TAB    &kp GRAVE    &kp AMPS     &kp CARET    &kp PIPE     &kp TILDE      &kp EXCL  &kp LBKT     &kp RBKT     &kp SQT      &kp DQT &kp BSPC
   &bt BT_CLR &kp FSLH     &kp STAR     &kp PLUS     &kp COLON    &kp SEMI       &kp UNDER &kp LPAR     &kp RPAR     &kp MINUS    &kp EQUAL &trans
   &kp LSHFT  &kp PRCNT    &kp HASH     &kp LT       &kp GT       &kp QMARK      &kp BSLH  &kp LBRC     &kp RBRC     &kp AT       &kp DLLR &trans
                                        &kp TAB      &kp SPACE    &to NAV        &kp RET   &kp BSPC     &to BASE_WIN
                        >;
                };

        // Mano sinistra trasparente → cade sul layer BASE
        // ┌────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │    │    │    │    │    │              │ /  │ 7  │ 8  │ 9  │ -  │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │    │    │    │    │    │              │ 0  │ 4  │ 5  │ 6  │ +  │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │    │    │    │    │    │              │ .  │ 1  │ 2  │ 3  │ *  │
        // └────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ →NAV ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                num_layer {
                        bindings = <
   &kp  TAB  &trans       &trans       &trans       &trans       &trans         &kp FSLH  &kp N7       &kp N8       &kp N9       &kp MINUS &kp BSPC
   &kp LCTRL &trans       &trans       &trans       &trans       &trans         &kp N0    &kp N4       &kp N5       &kp N6       &kp PLUS &kp GRAVE
   &kp LSHFT &trans       &trans       &trans       &trans       &trans         &kp DOT   &kp N1       &kp N2       &kp N3       &kp STAR &kp TILDE
                                       &kp TAB      &kp SPACE    &to NAV        &kp RET   &kp BSPC     &to BASE_WIN
                        >;
                };

        // Posizioni mnemoniche QWERTY: W=é E=è A=à  U=ù I=ì O=ò
        // ┌────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │    │ é  │ è  │    │    │              │    │ ù  │ ì  │ ò  │    │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │ à  │    │    │    │    │              │    │    │    │    │    │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │    │    │    │    │    │              │    │    │    │    │    │
        // └────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ →NAV ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                acc_layer {
                        bindings = <
   &kp  TAB  &trans       &it_e_acu    &it_e_grv    &trans       &trans         &trans    &it_u_grv    &it_i_grv    &it_o_grv    &trans &kp BSPC
   &kp LCTRL &it_a_grv    &trans       &trans       &trans       &trans         &trans    &trans       &trans       &trans       &trans &kp GRAVE
   &kp LSHFT &trans       &trans       &trans       &trans       &trans         &trans    &trans       &trans       &trans       &trans &kp TILDE
                                       &kp TAB      &kp SPACE    &null          &kp RET   &kp BSPC     &to BASE_WIN
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬──────┐
        // │  F1  │ F2 │ F3 │ F4 │ F5 │              │ F6 │ F7 │ F8 │ F9 │ F10  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │ F11  │F12 │    │    │    │              │ ←  │ ↓  │ ↑  │ →  │ MCTG │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │BTCLR │BT0 │BT1 │BT2 │BT3 │              │HOME│PGDN│PGUP│END │      │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴──────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ BASE ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                nav_layer {
                        bindings = <
   &kp  TAB  &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6    &kp F7       &kp F8       &kp F9       &kp F10 &kp BSPC
   &kp LCTRL &kp F11      &kp F12      &trans       &trans       &trans         &kp LEFT  &kp DOWN     &kp UP       &kp RIGHT    &tog BASE_MAC &kp GRAVE
   &kp LSHFT &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &kp HOME  &kp PG_DN    &kp PG_UP    &kp END      &trans &kp TILDE
                                       &kp TAB      &kp SPACE    &to BASE_WIN   &kp RET   &kp BSPC     &to BASE_WIN
                        >;
                };

                base_mac_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &trans       &trans       &trans       &trans       &trans         &trans    &trans       &trans       &trans       &trans &kp BSPC
   &kp LCTRL &hm LCTRL A  &hm LALT S   &hm LGUI D   &hm LSHFT F  &trans         &trans    &hm RSHFT J  &hm RGUI K   &hm RALT L   &hm RCTRL SEMI &kp GRAVE
   &kp LSHFT &trans       &trans       &trans       &trans       &trans         &trans    &trans       &trans       &trans       &trans &kp TILDE
                                       &trans       &trans       &trans         &trans    &trans       &trans
                        >;
                };
        };
};