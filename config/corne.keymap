#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC      0
#define WIN      1
#define SYM      2
#define NUM      3
#define ACC      4
#define MED      5
#define MNAV     6
#define WNAV     7
#define MMOU     8
#define WMOU     9
#define FUN      10

/* =============================================================
 * MACROS — Accenti italiani (dead key: grave/acute + lettera)
 * Funzionano con layout US International o Italiano su OS.
 * ============================================================= */
/ {
    macros {
        it_a_grv: it_a_grv { compatible = "zmk,behavior-macro"; label = "IT_A_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp A>; };
        it_e_grv: it_e_grv { compatible = "zmk,behavior-macro"; label = "IT_E_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp E>; };
        it_e_acu: it_e_acu { compatible = "zmk,behavior-macro"; label = "IT_E_ACU"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp SQT   &kp E>; };
        it_i_grv: it_i_grv { compatible = "zmk,behavior-macro"; label = "IT_I_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp I>; };
        it_o_grv: it_o_grv { compatible = "zmk,behavior-macro"; label = "IT_O_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp O>; };
        it_u_grv: it_u_grv { compatible = "zmk,behavior-macro"; label = "IT_U_GRV"; #binding-cells = <0>; wait-ms = <30>; tap-ms = <30>; bindings = <&kp GRAVE &kp U>; };
        win_copy: win_copy {
                copatible = "zmk,behavior-macro";
                label = "WIN_COPY";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LCTRL>, 
                           <&macro_tap &kp C>, 
                           <&macro_release &kp LCTRL>;
        };
        win_cut: win_cut {
                copatible = "zmk,behavior-macro";
                label = "WIN_CUT";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LCTRL>, 
                           <&macro_tap &kp X>, 
                           <&macro_release &kp LCTRL>;
        };
        win_paste: win_paste {
                copatible = "zmk,behavior-macro";
                label = "WIN_PASTE";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LCTRL>, 
                           <&macro_tap &kp V>, 
                           <&macro_release &kp LCTRL>;
        };
        win_undo: win_undo {
                copatible = "zmk,behavior-macro";
                label = "WIN_UNDO";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LCTRL>, 
                           <&macro_tap &kp Z>, 
                           <&macro_release &kp LCTRL>;
        };
        win_redo: win_redo {
                copatible = "zmk,behavior-macro";
                label = "WIN_REDO";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LCTRL>, 
                           <&macro_tap &kp Y>, 
                           <&macro_release &kp LCTRL>;
        };
        mac_copy: mac_copy {
                copatible = "zmk,behavior-macro";
                label = "MAC_COPY";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LGUI>, 
                           <&macro_tap &kp C>, 
                           <&macro_release &kp LGUI>;
        };
        mac_cut: mac_cut {
                copatible = "zmk,behavior-macro";
                label = "MAC_CUT";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LGUI>, 
                           <&macro_tap &kp X>, 
                           <&macro_release &kp LGUI>;
        };
        mac_paste: mac_paste {
                copatible = "zmk,behavior-macro";
                label = "MAC_PASTE";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LGUI>, 
                           <&macro_tap &kp V>, 
                           <&macro_release &kp LGUI>;
        };
        mac_undo: mac_undo {
                copatible = "zmk,behavior-macro";
                label = "MAC_UNDO";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LGUI>, 
                           <&macro_tap &kp Z>, 
                           <&macro_release &kp LGUI>;
        };
        mac_redo: mac_redo {
                copatible = "zmk,behavior-macro";
                label = "MAC_REDO";
                #binding-cells = <0>;
                bindings = <&macro_press &kp LGUI>, 
                           <&macro_press &kp LSHFT>,
                           <&macro_tap &kp Z>, 
                           <&macro_release &kp LSHFT>,
                           <&macro_release &kp LGUI>;
        };
    };

/* =============================================================
 * HOME ROW MODS
 * ============================================================= */
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        th: backspace_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>; // Il tempo (in ms) per cui devi tenere premuto per attivare il layer
            quick-tap-ms = <200>;    // Permette di fare tap ripetuti per cancellare velocemente
            bindings = <&mo>, <&kp>;
        };
    };

/* =============================================================
 * KEYMAP — Carosello: BASE ▶ SYM ▶ NUM ▶ ACC ▶ NAV ▶ BASE
 * Thumb sx-esterno = avanza carosello
 * Thumb dx-esterno = torna a BASE (HOME)
 * MAC toggle = &tog BASE_MAC dal layer NAV
 * ============================================================= */

        keymap {
                compatible = "zmk,keymap";
        // ┌────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │ Q  │ W  │ E  │ R  │ T  │              │ Y  │ U  │ I  │ O  │ P  │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │A/⌥ │S/⌃ │D/⌘ │F/⇧ │ G  │              │ H  │J/⇧ │K/⌘ │L/⌃ │;/⌥ │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │ Z  │ X  │ C  │ V  │ B  │              │ N  │ M  │ ,  │ .  │ /  │
        // └────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────────┬────────┐  ┌──────────┬─────┬─────┐
        //      │ ESC │ SPACE.    │  TAB   │  │ RETURN   │ RET │ DEL │
        //      └─────┴───────────┴────────┘  └──────────┴─────┴─────┘
                mac_base {
                        bindings = <
   &none   &kp Q        &kp W        &kp E        &kp R        &kp T          &kp Y     &kp U        &kp I        &kp O        &kp P           &none
   &none   &hm LALT A   &hm LCTRL S   &hm LGUI D  &hm LSHFT F  &kp G          &kp H     &hm RSHFT J  &hm RGUI K  &hm RCTRL L   &hm LALT SEMI   &none
   &none   &th 10 Z     &kp X        &kp C        &kp V        &kp B          &kp N     &kp M        &kp COMMA    &kp DOT      &kp FSLH        &none
                                     &th 5 ESC    &th 3 SPACE  &th 2 TAB      &th 8 RET &th 4 BSPC   &th 6 DEL
                        >;
                };

                win_base {
                        bindings = <
   &none   &kp Q        &kp W        &kp E        &kp R        &kp T          &kp Y     &kp U        &kp I        &kp O        &kp P           &none
   &none   &hm LALT A   &hm LGUI S   &hm LCTRL D  &hm LSHFT F  &kp G          &kp H     &hm RSHFT J  &hm RCTRL K  &hm RGUI L   &hm LALT SEMI   &none
   &none   &th 10 Z     &kp X        &kp C        &kp V        &kp B          &kp N     &kp M        &kp COMMA    &kp DOT      &kp FSLH        &none
                                     &th 5 ESC    &th 3 SPACE  &th 2 TAB      &th 9 RET &th 4 BSPC   &th 7 DEL
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │  `   │ &  │ ^  │ |  │ ~  │              │ !  │ [  │ ]  │ '  │ "  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │  /   │ *  │ +  │ :  │ ;  │              │ _  │ (  │ )  │ -  │ =  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │  %   │ #  │ <  │ >  │ ?  │              │ \  │ {  │ }  │ @  │ $  │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ →NAV ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘

                sym_layer {
                        bindings = <
   &none    &kp GRAVE    &kp AMPS     &kp CARET    &kp PIPE     &kp TILDE      &kp EXCL  &kp LBKT     &kp RBKT     &kp SQT      &kp DQT   &none
   &none    &kp FSLH     &kp STAR     &kp PLUS     &kp COLON    &kp SEMI       &kp UNDER &kp LPAR     &kp RPAR     &kp MINUS    &kp EQUAL &none
   &none    &kp PRCNT    &kp HASH     &kp LT       &kp GT       &kp QMARK      &kp BSLH  &kp LBRC     &kp RBRC     &kp AT       &kp DLLR  &none
                                      &kp TAB      &trans       &none          &kp RET   &kp BSPC     &none
                        >;
                };

        // Mano sinistra trasparente → cade sul layer BASE
        // ┌────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │    │    │    │    │    │              │ /  │ 7  │ 8  │ 9  │ -  │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │    │    │    │    │    │              │    │ 4  │ 5  │ 6  │ +  │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │    │    │    │    │    │              │ .  │ 1  │ 2  │ 3  │ *  │
        // └────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │     │       │        │  │ RET  │  0   │      │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                num_layer {
                        bindings = <
   &none  &none       &none       &none       &none       &none         &kp FSLH  &kp N7       &kp N8       &kp N9       &kp MINUS &none
   &none  &none       &none       &none       &none       &none         &none     &kp N4       &kp N5       &kp N6       &kp PLUS  &none
   &none  &none       &none       &none       &none       &none         &kp DOT   &kp N1       &kp N2       &kp N3       &kp STAR  &none
                                  &none       &trans      &none         &kp RET   &kp BSPC     &kp N0
                        >;
                };

        // Posizioni mnemoniche QWERTY: W=é E=è A=à  U=ù I=ì O=ò
        // ┌────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬────┐
        // │    │ é  │ è  │    │    │              │    │ ù  │ ì  │ ò  │    │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │ à  │    │    │    │    │              │    │    │    │    │    │
        // ├────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼────┤
        // │    │    │    │    │    │              │    │    │    │    │    │
        // └────┴────┴────┴────┴────┘              └────┴────┴────┴────┴────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ →NAV ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                acc_layer {
                        bindings = <
   &none  &trans       &it_e_acu    &it_e_grv    &trans       &trans         &trans    &it_u_grv    &it_i_grv    &it_o_grv    &trans &none
   &none  &it_a_grv    &trans       &trans       &trans       &trans         &trans    &trans       &trans       &trans       &trans &none
   &none  &trans       &trans       &trans       &trans       &trans         &trans    &trans       &trans       &trans       &trans &none
                                       &trans       &trans       &trans         &trans    &trans       &trans
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬──────┐
        // │  F1  │ F2 │ F3 │ F4 │ F5 │              │ F6 │ F7 │ F8 │ F9 │ F10  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │ F11  │F12 │    │    │    │              │ ←  │ ↓  │ ↑  │ →  │ MCTG │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │BTCLR │BT0 │BT1 │BT2 │BT3 │              │HOME│PGDN│PGUP│END │      │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴──────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ BASE ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                media_layer {
                        bindings = <
   &none   &none      &none      &none       &none       &none         &none      &none        &none        &none        &none        &none
   &none   &none      &none      &none       &none       &none         &none      &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   &none
   &none   &none      &none      &none       &none       &none         &none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none
                                 &none       &none       &none         &none      &kp C_PP      &kp C_MUTE
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬──────┐
        // │  F1  │ F2 │ F3 │ F4 │ F5 │              │ F6 │ F7 │ F8 │ F9 │ F10  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │ F11  │F12 │    │    │    │              │ ←  │ ↓  │ ↑  │ →  │ MCTG │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │BTCLR │BT0 │BT1 │BT2 │BT3 │              │HOME│PGDN│PGUP│END │      │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴──────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ BASE ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                mac_nav_layer {
                        bindings = <
   &none   &none      &none     &none       &none       &none         &mac_redo &mac_paste   &mac_copy    &mac_cut     &mac_undo     &none
   &none   &kp LALT      &kp LCTRL    &kp LGUI       &kp LSHFT      &none         &caps_word  &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT     &none
   &none   &none      &none     &none       &none       &none         &kp INS   &kp HOME     &kp PG_DN    &kp PG_UP    &kp END       &none
                                &none       &trans      &none         &kp RET   &kp BSPC     &kp DEL
                        >;
                };

                win_nav_layer {
                        bindings = <
   &none   &none      &none     &none       &none       &none         &win_redo &win_paste   &win_copy    &win_cut     &win_undo     &none
   &none   &kp LALT      &kp LGUI     &kp LCTRL      &kp LSHFT      &none         &caps_word  &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT     &none
   &none   &none      &none     &none       &none       &none         &kp INS   &kp HOME     &kp PG_DN    &kp PG_UP    &kp END       &none
                                &none       &trans      &none         &kp RET   &kp BSPC     &kp DEL
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬──────┐
        // │  F1  │ F2 │ F3 │ F4 │ F5 │              │ F6 │ F7 │ F8 │ F9 │ F10  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │ F11  │F12 │    │    │    │              │ ←  │ ↓  │ ↑  │ →  │ MCTG │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │BTCLR │BT0 │BT1 │BT2 │BT3 │              │HOME│PGDN│PGUP│END │      │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴──────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ BASE ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                mac_mouse_layer {
                        bindings = <
   &none   &none      &none      &none       &none       &none         &mac_redo  &mac_paste     &mac_copy      &mac_cut     &mac_undo         &none
   &none   &kp LALT   &kp LCTRL  &kp LGUI    &kp LSHFT   &none         &none      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT   &none
   &none   &none      &none      &none       &none       &none         &none      &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT   &none
                                 &none       &none       &trans         &mkp MB2   &mkp MB1       &mkp MB3
                        >;
                };

                win_mouse_layer {
                        bindings = <
   &none   &none      &none      &none       &none       &none         &win_redo  &win_paste     &win_copy      &win_cut     &win_undo         &none
   &none   &kp LALT   &kp LGUI   &kp LCTRL   &kp LSHFT   &none         &none      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT   &none
   &none   &none      &none      &none       &none       &none         &none      &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT   &none
                                 &none       &none       &trans         &mkp MB2   &mkp MB1       &mkp MB3
                        >;
                };

        // ┌──────┬────┬────┬────┬────┐              ┌────┬────┬────┬────┬──────┐
        // │  F1  │ F2 │ F3 │ F4 │ F5 │              │ F6 │ F7 │ F8 │ F9 │ F10  │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │ F11  │F12 │    │    │    │              │ ←  │ ↓  │ ↑  │ →  │ MCTG │
        // ├──────┼────┼────┼────┼────┤              ├────┼────┼────┼────┼──────┤
        // │BTCLR │BT0 │BT1 │BT2 │BT3 │              │HOME│PGDN│PGUP│END │      │
        // └──────┴────┴────┴────┴────┘              └────┴────┴────┴────┴──────┘
        //      ┌─────┬───────┬────────┐  ┌──────┬──────┬──────┐
        //      │ TAB │ SPACE │ BASE ▶ │  │ ENT  │ BSPC │ HOME │
        //      └─────┴───────┴────────┘  └──────┴──────┴──────┘
                func_layer {
                        bindings = <
   &none   &kp F1     &kp F2        &kp F3      &kp F4      &kp F5        &kp F6     &kp F7    &kp F8     &kp F9    &kp F10   &none
   &none   &kp F11    &kp F12       &none       &none       &none         &none      &none     &none      &none     &none     &none
   &trans  &none      &none         &none       &none       &none         &none      &none     &none      &none     &none     &none
                                    &none       &none       &to 0         &to 1      &none     &none
                        >;
                };
        };
};